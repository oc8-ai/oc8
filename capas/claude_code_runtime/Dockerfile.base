# Shared foundation for all cli_harness runtime images -- mirrors paperclip's
# docker/agent-runtime/Dockerfile.base (Node + git + tini + non-root user),
# verified against that project's own README as a proven pattern for exactly
# this kind of headless-CLI-in-a-container setup.
FROM docker.io/library/node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git tini \
    && rm -rf /var/lib/apt/lists/*
# Python 3.12 + the shared "write a script for anything else" toolchain
# (design doc: docs/superpowers/specs/2026-09-19-generic-capability-tools-
# design.md). Debian bookworm's own apt python3 is 3.11 -- one minor below
# oc8's own `requires-python = ">=3.12"` -- so `uv python install` (a
# self-contained, relocatable CPython build, not the system package) is used
# instead of apt, the same tool Dockerfile.backend already uses to install
# oc8 itself.
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /bin/uv
# Both installers default into $HOME, which for this RUN (root) is /root --
# and /root is mode 0700, unreadable by anyone else. Since every child image
# drops to `USER node` at the end (see below), that left python3 and the
# Chromium binary invisible to the user the container actually runs as:
# "Permission denied" loading libpython3.12.so, "python3: command not found".
# Redirect both into /opt instead, which is world-readable by default.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN uv python install 3.12 \
    && ln -s "$(uv python find 3.12)" /usr/local/bin/python3 \
    && ln -s /usr/local/bin/python3 /usr/local/bin/python
RUN uv pip install --python 3.12 --system --break-system-packages playwright pillow pandas reportlab \
    && python3 -m playwright install --with-deps chromium \
    && chmod -R a+rX /opt/uv /opt/ms-playwright
# NO `useradd`, and NO `USER` here. Three build/runtime failures live in what
# this file used to do, all found by review and all fatal:
#
#   1. `useradd --uid 1000 ... oc8agent` fails outright -- node:22-bookworm-slim
#      already ships a `node` user AT uid/gid 1000, so adduser exits with
#      "UID 1000 is not unique" and the build aborts. The image's own `node`
#      user is what every child image and every plugin now uses; there is no
#      `oc8agent` anywhere.
#   2. Dropping to a non-root user HERE breaks every child image, because each
#      one's next instruction is `npm install -g <package>`, which writes into
#      root-owned /usr/local/lib/node_modules and fails with EACCES. So the
#      `USER node` line lives at the END of each child Dockerfile instead:
#      the install runs as root, and only the final running container drops
#      privileges.
#   3. The Python/Playwright toolchain above must be installed (and land
#      somewhere world-readable, see the ENV lines) before that drop, for the
#      same reason -- `node` cannot use anything it cannot read.
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--"]

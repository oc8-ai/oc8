# Shared foundation for all cli_harness runtime images -- mirrors paperclip's
# docker/agent-runtime/Dockerfile.base (Node + git + tini + non-root user),
# verified against that project's own README as a proven pattern for exactly
# this kind of headless-CLI-in-a-container setup.
FROM docker.io/library/node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git tini \
    && rm -rf /var/lib/apt/lists/*
# NO `useradd`, and NO `USER` here. Two build failures live in what this file
# used to do, both found by the final whole-branch review and both fatal:
#
#   1. `useradd --uid 1000 ... oc8agent` fails outright -- node:22-bookworm-slim
#      already ships a `node` user AT uid/gid 1000, so adduser exits with
#      "UID 1000 is not unique" and the build aborts. The image's own `node`
#      user is what every child image and every plugin now uses; there is no
#      `oc8agent` anywhere.
#   2. Dropping to a non-root user HERE breaks every child image, because each
#      one's next instruction is `npm install -g <package>`, which writes into
#      root-owned /usr/local/lib/node_modules and fails with EACCES. So the
#      `USER node` line lives at the END of each child Dockerfile instead:
#      the install runs as root, and only the final running container drops
#      privileges.
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--"]
